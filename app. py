@st.cache_resource
def train_model():
    texts = SAFE_MESSAGES + SUSPICIOUS_MESSAGES
    labels = ["Safe"] * len(SAFE_MESSAGES) + ["Suspicious"] * len(SUSPICIOUS_MESSAGES)
    pipeline = Pipeline([
        ("tfidf", TfidfVectorizer(analyzer="char", ngram_range=(2, 5), sublinear_tf=True)),
        ("classifier", MultinomialNB(alpha=0.3)),
    ])
    pipeline.fit(texts, labels)
    return pipeline

