def extract_urls(message):
    return re.findall(r"""(?:https?://|www\.)[^\s<>"']+""", message, flags=re.IGNORECASE)

def inspect_url(url):
    findings = []
    url = url.rstrip(".,!?;:،؛)")
    normalized = url if url.lower().startswith(("http://", "https://")) else "http://" + url
    try:
        parsed = urlparse(normalized)
        host = parsed.hostname or ""
        if not host: return ["تعذر تحليل الرابط"]
        if parsed.username or parsed.password: findings.append("بيانات دخول داخل عنوان الرابط")
        if host.lower().startswith("xn--") or ".xn--" in host.lower():
            findings.append("اسم نطاق بترميز قد يخفي بعض الحروف")
        try:
            ipaddress.ip_address(host)
            findings.append("الرابط يستخدم عنوان IP")
        except ValueError:
            pass
        if host.lower() in {"bit.ly", "tinyurl.com", "t.co", "is.gd", "cutt.ly", "rb.gy"}:
            findings.append("الرابط مختصر")
        if parsed.scheme.lower() == "http": findings.append("الرابط لا يستخدم HTTPS")
    except Exception:
        findings.append("تعذر تحليل الرابط")
    return findings

def analyze_message(message):
    findings = []
    score = 0
    for name, weight, pattern in RULES:
        if re.search(pattern, message, re.IGNORECASE):
            findings.append(name)
            score += weight

    urls = extract_urls(message)
    for url in urls:
        url_findings = inspect_url(url)
        if url_findings:
            score += 20
            findings.extend([f"{url}: {item}" for item in url_findings])

    prediction = model.predict([message])[0]
    probabilities = model.predict_proba([message])[0]
    classes = list(model.classes_)
    suspicious_probability = float(probabilities[classes.index("Suspicious")])
    if prediction == "Suspicious" and suspicious_probability >= 0.80:
        score += 10
    score = min(score, 100)

    if score >= 60:
        level = "High"
    elif score >= 30:
        level = "Medium"
    else:
        level = "Low"
    return {
        "score": score, "level": level, "findings": findings, "urls": urls,
        "prediction": prediction, "suspicious_probability": suspicious_probability
    }

